{
  // Worker + one Durable Object per room. Static Vite build is served from ./dist;
  // /api/* hits the Worker first, every other unknown path falls back to index.html
  // so share links like /ABCD load the app.
  "name": "punchline-party",
  "account_id": "9f04d330b9fb1e2b99bcb02a5f46fb03",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "jackbox.danbradbury.net", "custom_domain": true }]
}
